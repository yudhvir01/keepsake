#!/bin/sh
# Reject AI attribution lines in commit messages.
if grep -qiE '^co-authored-by:.*(claude|anthropic|copilot|gemini|codex|openai)|generated with .*(claude|copilot|gemini|codex)|noreply@anthropic\.com' "$1"; then
    echo "commit rejected: remove AI attribution (Co-Authored-By / 'Generated with') from the message." >&2
    exit 1
fi
